local autoWeaponCooldown = 0
local pickupRemote = nil

-- MM2'de silah alma yöntemi: karakteri silaha yaklaştır
RunService.Heartbeat:Connect(function()
    if not Config.AutoWeapon then return end
    if tick() - autoWeaponCooldown < 0.5 then return end
    if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return end
    
    local myPos = LP.Character.HumanoidRootPart.Position
    
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Tool") and v:FindFirstChild("Handle") then
            local dist = (v.Handle.Position - myPos).Magnitude
            if dist < 30 and dist > 3 then
                -- Kademeli yaklaş (rubber-band yemesin)
                local target = v.Handle.Position
                local dir = (target - myPos).Unit
                local moveTo = myPos + dir * 3
                LP.Character.HumanoidRootPart.CFrame = CFrame.new(moveTo)
                autoWeaponCooldown = tick()
                break
            end
        end
    end
end)

