-- ============================================================
-- ROL TESPİTİ (doğru yöntem: karakterdeki gerçek Tool)
-- ============================================================
local function getRole(plr)
    if not plr.Character then return "masum" end
    local char = plr.Character
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local n = tool.Name:lower()
        if n:find("knife") or n:find("blade") or n:find("sword") or n:find("dagger") then
            return "katil"
        elseif n:find("gun") or n:find("revolver") or n:find("pistol") then
            return "şerif"
        end
    end
    return "masum"
end

local function getESPColor(plr)
    local role = getRole(plr)
    if role == "katil" then return Color3.fromRGB(255, 50, 50) end
    if role == "şerif" then return Color3.fromRGB(50, 120, 255) end
    return Color3.fromRGB(255, 255, 255)
end

