local Settings = {
	AimLock = false,
	AimAssist = true,
	ESP = true,
	AutoPickup = true,

	AimSmoothness = 0.16,
	PickupDistance = 11,
}

local ROLE_COLORS = {
	Murderer = Color3.fromRGB(255, 45, 45),
	Sheriff = Color3.fromRGB(50, 130, 255),
	Innocent = Color3.fromRGB(50, 230, 100)
}

--============================================================
-- PLAYER FUNCTIONS
--============================================================

local function getRole(player)
	return player:GetAttribute("Role") or "Innocent"
end

local function getCharacter(player)
	return player and player.Character
end

local function getHumanoid(player)
	local character = getCharacter(player)

	if not character then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function getRoot(player)
	local character = getCharacter(player)

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function getHead(player)
	local character = getCharacter(player)

	if not character then
		return nil
	end

	return character:FindFirstChild("Head")
end

local function alive(player)
	local humanoid = getHumanoid(player)

	return humanoid and humanoid.Health > 0
end

--============================================================
-- DISTANCE
--============================================================

local function distanceFromMe(player)
	local myRoot = getRoot(LocalPlayer)
	local targetRoot = getRoot(player)

	if not myRoot or not targetRoot then
		return math.huge
	end

	return (myRoot.Position - targetRoot.Position).Magnitude
end

--============================================================
-- TARGET SEARCH
--============================================================

local function closestRole(role)

	local bestPlayer = nil
	local bestDistance = math.huge

	for _, player in ipairs(Players:GetPlayers()) do

		if player ~= LocalPlayer
			and alive(player)
			and getRole(player) == role then

			local distance = distanceFromMe(player)

			if distance < bestDistance then
				bestDistance = distance
				bestPlayer = player
			end
		end
	end

	return bestPlayer
end

--============================================================
-- ROLE-BASED TARGET PRIORITY
--============================================================

local function getBestTarget()

	if not alive(LocalPlayer) then
		return nil
	end

	local myRole = getRole(LocalPlayer)

	----------------------------------------------------------
	-- SHERIFF
	-- Only Murderer
	----------------------------------------------------------

	if myRole == "Sheriff" then
		return closestRole("Murderer")
	end

	----------------------------------------------------------
	-- MURDERER
	-- Sheriff first
	----------------------------------------------------------

	if myRole == "Murderer" then

		local sheriff = closestRole("Sheriff")

		if sheriff then
			return sheriff
		end

		return closestRole("Innocent")
	end

	return nil
end

--============================================================
-- SIMPLE ESP
--============================================================

local Highlights = {}

local function removeESP(player)

	local highlight = Highlights[player]

	if highlight then
		highlight:Destroy()
		Highlights[player] = nil
	end
end

local function updateESP(player)

	if player == LocalPlayer then
		return
	end

	removeESP(player)

	if not Settings.ESP then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local role = getRole(player)
	local color = ROLE_COLORS[role]

	if not color then
		return
	end

	local highlight = Instance.new("Highlight")

	highlight.Name = "RoleHighlight"
	highlight.Adornee = character

	-- Sade görünüm
	highlight.FillTransparency = 0.88
	highlight.OutlineTransparency = 0

	highlight.FillColor = color
	highlight.OutlineColor = color

	highlight.DepthMode =
		Enum.HighlightDepthMode.AlwaysOnTop

	highlight.Parent = character

	Highlights[player] = highlight
end

local function setupPlayer(player)

	if player == LocalPlayer then
		return
	end

	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		updateESP(player)
	end)

	player:GetAttributeChangedSignal("Role"):Connect(function()
		updateESP(player)
	end)

	if player.Character then
		updateESP(player)
	end
end

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(player)
	removeESP(player)
end)

--============================================================
-- AIM LOCK
--============================================================

local currentTarget = nil

local function updateAim()

	if not Settings.AimLock then
		currentTarget = nil
		return
	end

	currentTarget = getBestTarget()

	if not currentTarget then
		return
	end

	local head = getHead(currentTarget)

	if not head then
		return
	end

	local cameraPosition =
		Camera.CFrame.Position

	local targetCFrame =
		CFrame.lookAt(
			cameraPosition,
			head.Position
		)

	Camera.CFrame =
		Camera.CFrame:Lerp(
			targetCFrame,
			Settings.AimSmoothness
		)
end

RunService.RenderStepped:Connect(updateAim)

--============================================================
-- FIRE
--============================================================

local function attack()

	local target = getBestTarget()

	if not target then
		return
	end

	local role = getRole(LocalPlayer)

	if role == "Sheriff" then

		ShootRemote:FireServer(target)

	elseif role == "Murderer" then

		ThrowKnifeRemote:FireServer(target)

	end
end

--============================================================
-- AUTO GUN PICKUP
--============================================================

local pickupCooldown = false

local function checkDroppedGun()

	if not Settings.AutoPickup then
		return
	end

	if pickupCooldown then
		return
	end

	-- Murderer shouldn't get sheriff gun
	if getRole(LocalPlayer) == "Murderer" then
		return
	end

	local gun =
		workspace:FindFirstChild("DroppedSheriffGun")

	if not gun then
		return
	end

	local root = getRoot(LocalPlayer)

	if not root then
		return
	end

	local distance =
		(root.Position - gun.Position).Magnitude

	if distance <= Settings.PickupDistance then

		pickupCooldown = true

		PickupGunRemote:FireServer()

		task.delay(1, function()
			pickupCooldown = false
		end)
	end
end

RunService.Heartbeat:Connect(checkDroppedGun)

