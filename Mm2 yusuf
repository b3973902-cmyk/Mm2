local function slider(p, h, min, max, def, cb)
    local f = card(p, h, "Değer: " .. def)
    local val = nil
    for _, v in pairs(f:GetChildren()) do
        if v:IsA("TextLabel") and v.Text:find("Değer") then val = v end
    end
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -24, 0, 6)
    track.Position = UDim2.new(0, 12, 1, -14)
    track.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    track.Parent = f
    corner(track, 3)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((def - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = C.accent
    fill.Parent = track
    corner(fill, 3)
    local drag = false
    local function update(i)
        local pos = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        local v = math.floor(min + (max - min) * pos)
        if val then val.Text = "Değer: " .. v end
        if cb then cb(v) end
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true; update(i)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then update(i) end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
    end)
end

