-- StarterPlayer > StarterPlayerScripts > LocalScript

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Me = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local Remotes = RS:WaitForChild("GameRemotes")
local Shoot = Remotes:WaitForChild("Shoot")
local Knife = Remotes:WaitForChild("ThrowKnife")
local Pickup = Remotes:WaitForChild("PickupGun")

local AIM_LOCK = false
local ESP = true
local AUTO_GUN = true

local COLORS = {
	Murderer = Color3.fromRGB(255, 45, 45),
	Sheriff = Color3.fromRGB(40, 130, 255),
	Innocent = Color3.fromRGB(50, 230, 100)
}

local function role(p)
	return p:GetAttribute("Role") or "Innocent"
end

local function alive(p)
	local c = p.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	return h and h.Health > 0
end

local function root(p)
	return p.Character and p.Character:FindFirstChild("HumanoidRootPart")
end

local function head(p)
	return p.Character and p.Character:FindFirstChild("Head")
end

local function nearest(targetRole)
	local myRoot = root(Me)
	if not myRoot then return nil end

	local best
	local bestDistance = math.huge

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= Me and alive(p) and role(p) == targetRole then
			local r = root(p)

			if r then
				local d = (myRoot.Position - r.Position).Magnitude

				if d < bestDistance then
					bestDistance = d
					best = p
				end
			end
		end
	end

	return best
end

local function target()
	local myRole = role(Me)

	-- Şerif -> Katil
	if myRole == "Sheriff" then
		return nearest("Murderer")
	end

	-- Katil -> önce Şerif
	if myRole == "Murderer" then
		return nearest("Sheriff") or nearest("Innocent")
	end

	return nil
end

--------------------------------------------------
-- SADE ESP
--------------------------------------------------

local function makeESP(p)
	if p == Me or not p.Character then return end

	local old = p.Character:FindFirstChild("SimpleRoleESP")
	if old then old:Destroy() end

	if not ESP then return end

	local h = Instance.new("Highlight")
	h.Name = "SimpleRoleESP"
	h.Adornee = p.Character

	local color = COLORS[role(p)] or Color3.new(1,1,1)

	h.FillColor = color
	h.OutlineColor = color

	h.FillTransparency = 0.9
	h.OutlineTransparency = 0

	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = p.Character
end

local function setup(p)
	p.CharacterAdded:Connect(function()
		task.wait(.5)
		makeESP(p)
	end)

	p:GetAttributeChangedSignal("Role"):Connect(function()
		makeESP(p)
	end)

	if p.Character then
		makeESP(p)
	end
end

for _,p in ipairs(Players:GetPlayers()) do
	setup(p)
end

Players.PlayerAdded:Connect(setup)

--------------------------------------------------
-- AIM LOCK
--------------------------------------------------

RunService.RenderStepped:Connect(function()

	if not AIM_LOCK then return end

	local t = target()
	if not t then return end

	local h = head(t)
	if not h then return end

	local desired = CFrame.lookAt(
		Camera.CFrame.Position,
		h.Position
	)

	Camera.CFrame = Camera.CFrame:Lerp(desired, 0.18)
end)

--------------------------------------------------
-- ATTACK
--------------------------------------------------

local function attack()
	local t = target()
	if not t then return end

	if role(Me) == "Sheriff" then
		Shoot:FireServer(t)

	elseif role(Me) == "Murderer" then
		Knife:FireServer(t)
	end
end

--------------------------------------------------
-- AUTO GUN PICKUP
--------------------------------------------------

local lastPickup = 0

RunService.Heartbeat:Connect(function()

	if not AUTO_GUN then return end
	if role(Me) == "Murderer" then return end

	local gun = workspace:FindFirstChild("DroppedSheriffGun")
	local myRoot = root(Me)

	if not gun or not myRoot then return end

	if (myRoot.Position - gun.Position).Magnitude <= 11 then

		if os.clock() - lastPickup >= 1 then
			lastPickup = os.clock()
			Pickup:FireServer()
		end
	end
end)

