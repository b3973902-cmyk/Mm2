--============================================================
-- GAME SERVER
-- Murderer / Sheriff / Innocent
-- Roblox Studio - ServerScriptService
--============================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--------------------------------------------------------------
-- REMOTES
--------------------------------------------------------------

local Remotes = ReplicatedStorage:FindFirstChild("GameRemotes")

if not Remotes then
	Remotes = Instance.new("Folder")
	Remotes.Name = "GameRemotes"
	Remotes.Parent = ReplicatedStorage
end

local function remote(name)
	local r = Remotes:FindFirstChild(name)

	if not r then
		r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = Remotes
	end

	return r
end

local ShootRemote = remote("Shoot")
local ThrowKnifeRemote = remote("ThrowKnife")
local PickupGunRemote = remote("PickupGun")

--------------------------------------------------------------
-- CONFIG
--------------------------------------------------------------

local CONFIG = {

	ROUND_TIME = 180,

	INTERMISSION = 15,

	SHERIFF_DAMAGE = 100,

	KNIFE_DAMAGE = 100,

	MAX_SHOOT_DISTANCE = 300,

	MAX_KNIFE_DISTANCE = 120,

	GUN_PICKUP_DISTANCE = 12,

	SHOT_COOLDOWN = 0.65,

	KNIFE_COOLDOWN = 0.8,
}

--------------------------------------------------------------
-- RUNTIME DATA
--------------------------------------------------------------

local lastShot = {}
local lastKnife = {}

local droppedGun = nil

--------------------------------------------------------------
-- UTILITIES
--------------------------------------------------------------

local function getCharacter(player)

	if not player then
		return nil
	end

	return player.Character
end

local function getHumanoid(player)

	local character = getCharacter(player)

	if not character then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function getRoot(player)

	local character = getCharacter(player)

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function isAlive(player)

	local humanoid = getHumanoid(player)

	return humanoid
		and humanoid.Health > 0
end

local function getRole(player)

	return player:GetAttribute("Role")
end

local function setRole(player, role)

	player:SetAttribute("Role", role)
end

--------------------------------------------------------------
-- ROLE MANAGEMENT
--------------------------------------------------------------

local function clearRoles()

	for _, player in ipairs(Players:GetPlayers()) do

		setRole(player, "Innocent")
	end
end

local function chooseRandomPlayer(list)

	if #list == 0 then
		return nil
	end

	return list[math.random(1, #list)]
end

local function assignRoles()

	local players = Players:GetPlayers()

	if #players < 2 then
		return
	end

	clearRoles()

	local murderer = chooseRandomPlayer(players)

	if murderer then
		setRole(murderer, "Murderer")
	end

	local sheriffCandidates = {}

	for _, player in ipairs(players) do

		if player ~= murderer then

			table.insert(
				sheriffCandidates,
				player
			)
		end
	end

	local sheriff =
		chooseRandomPlayer(
			sheriffCandidates
		)

	if sheriff then
		setRole(
			sheriff,
			"Sheriff"
		)
	end
end

--------------------------------------------------------------
-- TARGET VALIDATION
--------------------------------------------------------------

local function canTarget(attacker, target)

	if not attacker or not target then
		return false
	end

	if attacker == target then
		return false
	end

	if not isAlive(attacker)
		or not isAlive(target) then

		return false
	end

	local attackerRole =
		getRole(attacker)

	local targetRole =
		getRole(target)

	----------------------------------------------------------
	-- Sheriff can attack Murderer
	----------------------------------------------------------

	if attackerRole == "Sheriff" then

		return targetRole == "Murderer"
	end

	----------------------------------------------------------
	-- Murderer can attack Sheriff/Innocent
	----------------------------------------------------------

	if attackerRole == "Murderer" then

		return
			targetRole == "Sheriff"
			or
			targetRole == "Innocent"
	end

	return false
end

--------------------------------------------------------------
-- DISTANCE
--------------------------------------------------------------

local function distanceBetweenPlayers(a, b)

	local rootA = getRoot(a)
	local rootB = getRoot(b)

	if not rootA or not rootB then
		return math.huge
	end

	return
		(rootA.Position - rootB.Position).Magnitude
end

--------------------------------------------------------------
-- SHERIFF SHOOTING
--------------------------------------------------------------

ShootRemote.OnServerEvent:Connect(
	function(player, target)

		if getRole(player) ~= "Sheriff" then
			return
		end

		if typeof(target) ~= "Instance" then
			return
		end

		if not target:IsA("Player") then
			return
		end

		if not canTarget(player, target) then
			return
		end

		------------------------------------------------------
		-- RATE LIMIT
		------------------------------------------------------

		local now = os.clock()

		if lastShot[player]
			and
			now - lastShot[player]
			< CONFIG.SHOT_COOLDOWN then

			return
		end

		lastShot[player] = now

		------------------------------------------------------
		-- DISTANCE CHECK
		------------------------------------------------------

		local distance =
			distanceBetweenPlayers(
				player,
				target
			)

		if distance >
			CONFIG.MAX_SHOOT_DISTANCE then

			return
		end

		------------------------------------------------------
		-- DAMAGE
		------------------------------------------------------

		local humanoid =
			getHumanoid(target)

		if humanoid then

			humanoid:TakeDamage(
				CONFIG.SHERIFF_DAMAGE
			)
		end
	end
)

--------------------------------------------------------------
-- MURDERER KNIFE
--------------------------------------------------------------

ThrowKnifeRemote.OnServerEvent:Connect(
	function(player, target)

		if getRole(player)
			~= "Murderer" then

			return
		end

		if typeof(target)
			~= "Instance" then

			return
		end

		if not target:IsA("Player") then
			return
		end

		if not canTarget(
			player,
			target
		) then

			return
		end

		------------------------------------------------------
		-- COOLDOWN
		------------------------------------------------------

		local now =
			os.clock()

		if lastKnife[player]
			and
			now - lastKnife[player]
			< CONFIG.KNIFE_COOLDOWN then

			return
		end

		lastKnife[player] = now

		------------------------------------------------------
		-- DISTANCE
		------------------------------------------------------

		local distance =
			distanceBetweenPlayers(
				player,
				target
			)

		if distance >
			CONFIG.MAX_KNIFE_DISTANCE then

			return
		end

		------------------------------------------------------
		-- DAMAGE
		------------------------------------------------------

		local humanoid =
			getHumanoid(target)

		if humanoid then

			humanoid:TakeDamage(
				CONFIG.KNIFE_DAMAGE
			)
		end
	end
)

--------------------------------------------------------------
-- DROPPED SHERIFF GUN
--------------------------------------------------------------

local function removeDroppedGun()

	if droppedGun then

		droppedGun:Destroy()

		droppedGun = nil
	end
end

local function createDroppedGun(position)

	removeDroppedGun()

	local gun = Instance.new("Part")

	gun.Name = "DroppedSheriffGun"

	gun.Size =
		Vector3.new(
			1.6,
			0.5,
			2.2
		)

	gun.Position =
		position
		+
		Vector3.new(
			0,
			1,
			0
		)

	gun.Anchored = false

	gun.CanCollide = true

	gun.Material =
		Enum.Material.Metal

	gun.Parent =
		workspace

	droppedGun = gun
end

--------------------------------------------------------------
-- PICKUP
--------------------------------------------------------------

PickupGunRemote.OnServerEvent:Connect(
	function(player)

		if not droppedGun then
			return
		end

		if not isAlive(player) then
			return
		end

		------------------------------------------------------
		-- Murderer cannot pick sheriff gun
		------------------------------------------------------

		if getRole(player)
			== "Murderer" then

			return
		end

		local root =
			getRoot(player)

		if not root then
			return
		end

		local distance =
			(
				root.Position
				-
				droppedGun.Position
			).Magnitude

		if distance >
			CONFIG.GUN_PICKUP_DISTANCE then

			return
		end

		------------------------------------------------------
		-- Innocent becomes Sheriff
		------------------------------------------------------

		setRole(
			player,
			"Sheriff"
		)

		removeDroppedGun()
	end
)

--------------------------------------------------------------
-- DEATH HANDLING
--------------------------------------------------------------

local function characterAdded(player, character)

	local humanoid =
		character:WaitForChild(
			"Humanoid"
		)

	humanoid.Died:Connect(
		function()

			local role =
				getRole(player)

			--------------------------------------------------
			-- Sheriff died -> drop gun
			--------------------------------------------------

			if role == "Sheriff" then

				local root =
					character:FindFirstChild(
						"HumanoidRootPart"
					)

				if root then

					createDroppedGun(
						root.Position
					)
				end
			end
		end
	)
end

--------------------------------------------------------------
-- PLAYER SETUP
--------------------------------------------------------------

local function playerAdded(player)

	player:SetAttribute(
		"Role",
		"Innocent"
	)

	player.CharacterAdded:Connect(
		function(character)

			characterAdded(
				player,
				character
			)
		end
	)

	if player.Character then

		characterAdded(
			player,
			player.Character
		)
	end
end

for _, player in ipairs(
	Players:GetPlayers()
) do

	playerAdded(player)
end

Players.PlayerAdded:Connect(
	playerAdded
)

Players.PlayerRemoving:Connect(
	function(player)

		lastShot[player] = nil
		lastKnife[player] = nil
	end
)

--------------------------------------------------------------
-- ROUND CHECKS
--------------------------------------------------------------

local function murdererAlive()

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if getRole(player)
			== "Murderer"
			and
			isAlive(player) then

			return true
		end
	end

	return false
end

local function innocentTeamAlive()

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		local role =
			getRole(player)

		if (
			role == "Sheriff"
			or
			role == "Innocent"
		)
			and
			isAlive(player) then

			return true
		end
	end

	return false
end

--------------------------------------------------------------
-- ROUND LOOP
--------------------------------------------------------------

task.spawn(
	function()

		while true do

			--------------------------------------------------
			-- INTERMISSION
			--------------------------------------------------

			task.wait(
				CONFIG.INTERMISSION
			)

			removeDroppedGun()

			assignRoles()

			local start =
				os.clock()

			--------------------------------------------------
			-- ROUND
			--------------------------------------------------

			while
				os.clock() - start
				<
				CONFIG.ROUND_TIME
			do

				if not murdererAlive() then
					break
				end

				if not innocentTeamAlive() then
					break
				end

				task.wait(1)
			end

			--------------------------------------------------
			-- RESET
			--------------------------------------------------

			removeDroppedGun()

			for _, player in ipairs(
				Players:GetPlayers()
			) do

				setRole(
					player,
					"Innocent"
				)
			end

			task.wait(3)
		end
	end
)

print(
	"[GameServer] Loaded successfully"
)
