--============================================================
-- BUTTON CREATOR
--============================================================

local buttonY = 70

local function createToggle(title, initialValue, callback)

	local button =
		Instance.new("TextButton")

	button.Size =
		UDim2.new(1, -30, 0, 48)

	button.Position =
		UDim2.fromOffset(
			15,
			buttonY
		)

	buttonY += 58

	button.BackgroundColor3 =
		Color3.fromRGB(24, 24, 29)

	button.TextColor3 =
		Color3.fromRGB(240, 240, 240)

	button.TextSize = 15

	button.Font =
		Enum.Font.GothamMedium

	button.Parent = Main

	local corner =
		Instance.new("UICorner")

	corner.CornerRadius =
		UDim.new(0, 9)

	corner.Parent =
		button

	local stroke =
		Instance.new("UIStroke")

	stroke.Color =
		Color3.fromRGB(65, 65, 70)

	stroke.Thickness = 1

	stroke.Parent =
		button

	local enabled =
		initialValue

	local function refresh()

		if enabled then

			button.Text =
				title .. "   [ON]"

			stroke.Color =
				Color3.fromRGB(
					220,
					35,
					35
				)

		else

			button.Text =
				title .. "   [OFF]"

			stroke.Color =
				Color3.fromRGB(
					65,
					65,
					70
				)
		end
	end

	button.MouseButton1Click:Connect(
		function()

			enabled = not enabled

			refresh()

			callback(enabled)
		end
	)

	refresh()

	return button
end

