-- ============================================================
-- SİLENT AİM (GunFired Hook)
-- ============================================================
local silentAimActive = false
local currentTarget = nil

local function isVisible(part)
    local ray = Ray.new(LP.Character.Head.Position, (part.Position - LP.Character.Head.Position).Unit * 500)
    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LP.Character})
    if hit and hit:IsDescendantOf(part.Parent) then return true end
    return false
end

local function getClosestTarget()
    if not LP.Character or not LP.Character:FindFirstChild("Head") then return nil end
    
    local myPos = LP.Character.Head.Position
    local closest = nil
    local closestDist = Config.FOV
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        if not plr.Character or not plr.Character:FindFirstChild("Head") then continue end
        if Config.TeamCheck and plr.Team == LP.Team then continue end
        
        local theirPos = plr.Character.Head.Position
        local dist = (theirPos - myPos).Magnitude
        
        if dist < closestDist then
            if Config.WallCheck and not isVisible(plr.Character.Head) then continue end
            closest = plr
            closestDist = dist
        end
    end
    
    return closest
end

-- GunFired hook
local GunFired = RS:WaitForChild("ClientServices", 10)
if GunFired then
    GunFired = GunFired:WaitForChild("WeaponService", 10)
    if GunFired then
        GunFired = GunFired:WaitForChild("GunFired", 10)
    end
end

if GunFired and GunFired:IsA("RemoteEvent") then
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if self == GunFired and method == "FireServer" and Config.SilentAim then
            local target = getClosestTarget()
            if target and target.Character and target.Character:FindFirstChild("Head") then
                -- Ateş argümanlarını hedefe çevir
                for i, v in pairs(args) do
                    if typeof(v) == "Vector3" then
                        args[i] = target.Character.Head.Position
                    elseif typeof(v) == "CFrame" then
                        args[i] = CFrame.new(LP.Character.Head.Position, target.Character.Head.Position)
                    end
                end
            end
            return oldNamecall(self, table.unpack(args))
        end
        
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end

