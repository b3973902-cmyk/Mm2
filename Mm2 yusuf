-- SİLENT AİM
-- ============================================================
local silentAimHeld = false

local function isVisible(part)
    if not LP.Character or not LP.Character:FindFirstChild("Head") then return false end
    local ray = Ray.new(LP.Character.Head.Position, (part.Position - LP.Character.Head.Position).Unit * 500)
    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LP.Character})
    return hit and hit:IsDescendantOf(part.Parent) or false
end

local function getClosestTarget()
    if not LP.Character or not LP.Character:FindFirstChild("Head") then return nil end
    local myPos = LP.Character.Head.Position
    local cam = workspace.CurrentCamera
    local closest, closestScreenDist = nil, Config.FOV
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        if not plr.Character or not plr.Character:FindFirstChild("Head") then continue end
        if plr:GetAttribute("Alive") == false then continue end
        
        local headPos = plr.Character.Head.Position
        local screenPos, onScreen = cam:WorldToViewportPoint(headPos)
        if not onScreen then continue end
        
        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)).Magnitude
        if screenDist < closestScreenDist then
            if Config.WallCheck and not isVisible(plr.Character.Head) then continue end
            closest = plr
            closestScreenDist = screenDist
        end
    end
    return closest
end

-- GunFired hook
local gunFired = RS:FindFirstChild("ClientServices")
if gunFired then gunFired = gunFired:FindFirstChild("WeaponService") end
if gunFired then gunFired = gunFired:FindFirstChild("GunFired") end

if gunFired then
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        if self == gunFired and getnamecallmethod() == "FireServer" and Config.SilentAim and silentAimHeld then
            local target = getClosestTarget()
            if target and target.Character and target.Character:FindFirstChild("Head") then
                local args = {...}
                for i, v in pairs(args) do
                    if typeof(v) == "Vector3" then
                        args[i] = target.Character.Head.Position
                    elseif typeof(v) == "CFrame" then
                        args[i] = CFrame.new(LP.Character.Head.Position, target.Character.Head.Position)
                    end
                end
                return old(self, table.unpack(args))
            end
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
end

