-- ============================================================
-- ROL TESPİTİ
-- ============================================================
local function getRole(plr)
    if not plr.Character then return "masum" end
    local char = plr.Character
    local tool = char:FindFirstChildOfClass("Tool")
    
    if tool then
        local n = tool.Name:lower()
        if n:find("knife") or n:find("blade") or n:find("sword") or n:find("dagger") or n:find("katana") then
            return "katil"
        elseif n:find("gun") or n:find("revolver") or n:find("pistol") or n:find("sheriff") then
            -- Şerif mi kahraman mı? İkisi de silah taşır.
            -- Kahraman = masum + silah. Şerif = başlangıçtan silahlı.
            -- Şimdilik ikisini de "şerif" say, sonra düzeltiriz.
            return "şerif"
        end
    end
    return "masum"
end

local function getESPColor(role)
    if role == "katil" then return Color3.fromRGB(255, 50, 50) end
    if role == "şerif" then return Color3.fromRGB(50, 120, 255) end
    if role == "kahraman" then return Color3.fromRGB(255, 215, 0) end
    return Color3.fromRGB(50, 255, 50) -- masum yeşil
end

-- ============================================================
-- ESP (her zaman açık)
-- ============================================================
local espCache = {}

local function createESP(plr)
    if plr == LP then return end
    if espCache[plr] then return end
    if not plr.Character then return end

    local role = getRole(plr)
    local color = getESPColor(role)

    local hl = Instance.new("Highlight")
    hl.Adornee = plr.Character
    hl.FillColor = color
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = plr.Character

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 140, 0, 38)
    bb.StudsOffset = Vector3.new(0, 3.5, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = plr.Character

    local nameL = Instance.new("TextLabel")
    nameL.Size = UDim2.fromScale(1, 0.6)
    nameL.BackgroundTransparency = 1
    nameL.Text = plr.Name
    nameL.TextColor3 = color
    nameL.TextStrokeTransparency = 0
    nameL.TextSize = 14
    nameL.Font = Enum.Font.GothamBold
    nameL.Parent = bb

    local roleL = Instance.new("TextLabel")
    roleL.Size = UDim2.fromScale(1, 0.4)
    roleL.Position = UDim2.fromScale(0, 0.6)
    roleL.BackgroundTransparency = 1
    roleL.Text = "[" .. string.upper(role) .. "]"
    roleL.TextColor3 = color
    roleL.TextStrokeTransparency = 0
    roleL.TextSize = 11
    roleL.Font = Enum.Font.Gotham
    roleL.Parent = bb

    bb.Parent = plr.Character
    espCache[plr] = {hl = hl, bb = bb}
end

local function removeESP(plr)
    if espCache[plr] then
        if espCache[plr].hl then espCache[plr].hl:Destroy() end
        if espCache[plr].bb then espCache[plr].bb:Destroy() end
        espCache[plr] = nil
    end
end

local function updateAllESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            createESP(plr)
        else
            removeESP(plr)
        end
    end
end

-- Rol değişince ESP rengini güncelle
RunService.Heartbeat:Connect(function()
    for plr, data in pairs(espCache) do
        if plr.Character and data.hl then
            local color = getESPColor(getRole(plr))
            data.hl.FillColor = color
            if data.bb then
                for _, v in pairs(data.bb:GetChildren()) do
                    if v:IsA("TextLabel") then v.TextColor3 = color end
                end
            end
        end
    end
end)

Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(1)
        createESP(plr)
    end)
end)
Players.PlayerRemoving:Connect(function(plr) removeESP(plr) end)

-- ============================================================
-- HEDEF SEÇİMİ (Aim Lock)
-- ============================================================
local function getMyRole()
    return getRole(LP)
end

local function findTarget()
    local myRole = getMyRole()
    local targetRole = nil
    
    if myRole == "şerif" then
        targetRole = "katil"
    elseif myRole == "katil" then
        targetRole = "şerif" -- şerif ölünce silahı alan kişi (kahraman) hedef olur
    else
        return nil -- masum kilitlenmez
    end
    
    local myPos = LP.Character and LP.Character:FindFirstChild("Head") and LP.Character.Head.Position
    if not myPos then return nil end
    
    local closest, closestDist = nil, 500
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        if not plr.Character or not plr.Character:FindFirstChild("Head") then continue end
        if plr:GetAttribute("Alive") == false then continue end
        
        local role = getRole(plr)
        if role == targetRole or (myRole == "katil" and role == "kahraman") then
            local dist = (plr.Character.Head.Position - myPos).Magnitude
            if dist < closestDist then
                closest = plr
                closestDist = dist
            end
        end
    end
    return closest
end

-- ============================================================
-- SİLENT AİM (GunFired hook)
-- ============================================================
local aimLockActive = false

local gunFired = RS:FindFirstChild("ClientServices")
if gunFired then gunFired = gunFired:FindFirstChild("WeaponService") end
if gunFired then gunFired = gunFired:FindFirstChild("GunFired") end

if gunFired then
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        if self == gunFired and getnamecallmethod() == "FireServer" and aimLockActive then
            local target = findTarget()
            if target and target.Character and target.Character:FindFirstChild("Head") then
                local args = {...}
                for i, v in pairs(args) do
                    if typeof(v) == "Vector3" then
                        args[i] = target.Character.Head.Position
                    elseif typeof(v) == "CFrame" then
                        args[i] = CFrame.new(LP.Character.Head.Position, target.Character.Head.Position)
                    end
                end
                return old(self, table.unpack(args))
            end
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
end

